# Production frontend environment variables (set these in Netlify / build env)
# Use the Netlify proxy URL so the app gets proper CORS headers.
# For local dev / website builds, leave this empty to use the relative /api path.
# For APK builds, set this to the deployed site URL (e.g. https://wirraljobe.com/).
VITE_API_URL=https://wirraljobe.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_SQUARE_APPLICATION_ID=your_square_application_id
VITE_SQUARE_LOCATION_ID=your_square_location_id
