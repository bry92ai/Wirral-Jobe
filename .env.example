# Production frontend environment variables (set these in Netlify / build env)
# For website builds via Netlify, leave this empty so /api is used (routed by netlify.toml to the proxy function).
# For APK builds, set this to the live Apps Script web app URL ending in /exec.
VITE_API_URL=https://script.google.com/macros/s/AKfycbw2N78ynEwuTcjh9zLfmoywJjJkB4mg6Np1s7toZBu06gyQEqun6TC2BPZXtenZznvy/exec
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_SQUARE_APPLICATION_ID=your_square_application_id
VITE_SQUARE_LOCATION_ID=your_square_location_id
